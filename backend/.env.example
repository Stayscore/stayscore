# Kopiere diese Datei zu ".env" und trage dort deine echten Werte ein.
# Die ".env"-Datei selbst wird NICHT in Git gespeichert (siehe .gitignore).

# --- Zugangsdaten deiner PostgreSQL-Datenbank (z.B. von neon.tech) ---
POSTGRES_HOST=dein-projekt.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=dein-benutzername
POSTGRES_PASSWORD=dein-passwort

# --- Einstellungen des Backend-Servers ---
# Geheimer Schlüssel, mit dem Login-Tokens signiert werden. Für lokale Tests
# reicht ein beliebiger langer Zufallstext.
JWT_SECRET=bitte-durch-einen-eigenen-zufallstext-ersetzen

# Auf welchem Port der Server lokal läuft
APP_PORT=8080

# Woher Anfragen erlaubt sind (dein lokales Frontend). Für lokale Tests
# kann das auch leer bleiben, dann sind alle Adressen erlaubt.
APP_ORIGIN=http://localhost:5173

# Auf "1" setzen, wenn beim Start automatisch Beispiel-Daten eingefügt werden sollen
SEED_DEMO=1
